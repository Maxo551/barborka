				Input3 = InstanceInput { SourceOp = "Glitch", Source = "fade", Name = "FADE", Default = 0.6 },
				Input4 = InstanceInput { SourceOp = "Glitch", Source = "blend", Name = "BLEND", Default = 0 },
				Input5 = InstanceInput { SourceOp = "Glitch", Source = "tint", Name = "TINT", Default = 1 },
				Input6 = InstanceInput { SourceOp = "Glitch", Source = "matte", Name = "MATTE", Default = 0 },
				Input7 = InstanceInput { SourceOp = "Glitch", Source = "drift", Name = "DRIFT", Default = 0.5 },
				Input8 = InstanceInput { SourceOp = "Glitch", Source = "glow", Name = "GLOW", Default = 0.25 },

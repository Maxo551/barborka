    case 6: { int n = 15; int k = ((i % n) + n) % n;
      switch (k) { case 0: return 111; case 1: return 113; case 2: return 101; case 3: return 110; case 4: return 105; case 5: return 106; case 6: return 109; case 7: return 115; case 8: return 102; case 9: return 112; case 10: return 107; case 11: return 108; case 12: return 103; case 13: return 114; case 14: return 104; } return 0; }

--[[
  GLITCH RIG — GR_Transition: Glitch transitions
  DaVinci Resolve / Fusion Fuse with DCTL GPU kernels.
  Generated by glitch-rig/resolve/build.js from the panel's catalogue — edit the
  sources there, not this file.
]]

FuRegisterClass("GR_Transition", CT_Tool, {
  REGS_Category = "Glitch Rig",
  REGS_OpIconString = "GRx",
  REGS_OpDescription = "Glitch Rig · Glitch transitions",
  REG_NoObjMatCtrls = true,
  REG_NoMotionBlurCtrls = true,
  REG_OpNoMask = true,
  REG_TimeVariant = true,
  REG_Version = 1,
})

GR_K = {}
GR_P = {}
GR_K.GRTrans = [==[
// GLITCH RIG — shared DCTL helpers for the Resolve/Fusion kernels.
// Written for every Fusion GPU backend (CUDA, OpenCL, Metal): no swizzles, no
// function overloading, float literals with an f suffix, and only the builtins
// that Fusion provides everywhere (_floor, _fabs, _sinf, _cosf, _powf, _sqrtf,
// _expf, _atan2f, _fmaxf, _fminf, _fmod). Images in Fusion are bottom-up, like GL.

#define GR_PI 3.14159265f

__DEVICE__ float gr_fract(float x) { return x - _floor(x); }
__DEVICE__ float gr_mod(float x, float y) { return x - y * _floor(x / y); }
__DEVICE__ float gr_mix(float a, float b, float t) { return a + (b - a) * t; }
__DEVICE__ float gr_clamp(float x, float a, float b) { return _fminf(_fmaxf(x, a), b); }
__DEVICE__ float gr_sat(float x) { return gr_clamp(x, 0.0f, 1.0f); }
__DEVICE__ float gr_step(float e, float x) { return x < e ? 0.0f : 1.0f; }
__DEVICE__ float gr_smooth(float a, float b, float x) {
  float t = gr_sat((x - a) / (b - a));
  return t * t * (3.0f - 2.0f * t);
}
__DEVICE__ float gr_len(float x, float y) { return _sqrtf(x * x + y * y); }

__DEVICE__ float3 gr_v3(float x, float y, float z) { return to_float3(x, y, z); }
__DEVICE__ float3 gr_mix3(float3 a, float3 b, float t) { return to_float3(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t, a.z + (b.z - a.z) * t); }
__DEVICE__ float3 gr_scale3(float3 a, float s) { return to_float3(a.x * s, a.y * s, a.z * s); }
__DEVICE__ float3 gr_add3(float3 a, float3 b) { return to_float3(a.x + b.x, a.y + b.y, a.z + b.z); }
__DEVICE__ float3 gr_sub3(float3 a, float3 b) { return to_float3(a.x - b.x, a.y - b.y, a.z - b.z); }
__DEVICE__ float3 gr_mul3(float3 a, float3 b) { return to_float3(a.x * b.x, a.y * b.y, a.z * b.z); }
__DEVICE__ float3 gr_max3(float3 a, float3 b) { return to_float3(_fmaxf(a.x, b.x), _fmaxf(a.y, b.y), _fmaxf(a.z, b.z)); }
__DEVICE__ float3 gr_clamp3(float3 a, float lo, float hi) { return to_float3(gr_clamp(a.x, lo, hi), gr_clamp(a.y, lo, hi), gr_clamp(a.z, lo, hi)); }
__DEVICE__ float3 gr_abs3(float3 a) { return to_float3(_fabs(a.x), _fabs(a.y), _fabs(a.z)); }
__DEVICE__ float gr_dist3(float3 a, float3 b) { float dx = a.x - b.x, dy = a.y - b.y, dz = a.z - b.z; return _sqrtf(dx * dx + dy * dy + dz * dz); }
__DEVICE__ float gr_luma(float3 c) { return c.x * 0.2126f + c.y * 0.7152f + c.z * 0.0722f; }

__DEVICE__ float gr_hash11(float p) {
  p = gr_fract(p * 0.1031f);
  p = p * (p + 33.33f);
  p = p * (p + p);
  return gr_fract(p);
}
__DEVICE__ float gr_hash21(float x, float y) {
  float a = gr_fract(x * 0.1031f), b = gr_fract(y * 0.1031f), c = gr_fract(x * 0.1031f);
  float d = a * (b + 33.33f) + b * (c + 33.33f) + c * (a + 33.33f);
  a += d; b += d; c += d;
  return gr_fract((a + b) * c);
}
__DEVICE__ float2 gr_hash22(float x, float y) {
  float a = gr_fract(x * 0.1031f), b = gr_fract(y * 0.1030f), c = gr_fract(x * 0.0973f);
  float d = a * (b + 33.33f) + b * (c + 33.33f) + c * (a + 33.33f);
  a += d; b += d; c += d;
  return to_float2(gr_fract((a + b) * c), gr_fract((a + c) * b));
}
__DEVICE__ float gr_noise(float x, float y) {
  float ix = _floor(x), iy = _floor(y), fx = x - ix, fy = y - iy;
  float ux = fx * fx * (3.0f - 2.0f * fx), uy = fy * fy * (3.0f - 2.0f * fy);
  float a = gr_hash21(ix, iy), b = gr_hash21(ix + 1.0f, iy);
  float c = gr_hash21(ix, iy + 1.0f), d = gr_hash21(ix + 1.0f, iy + 1.0f);
  return gr_mix(gr_mix(a, b, ux), gr_mix(c, d, ux), uy);
}
__DEVICE__ float gr_fbm(float x, float y) {
  float a = 0.5f, s = 0.0f;
  for (int i = 0; i < 5; i++) { s += a * gr_noise(x, y); x = x * 2.03f + 17.1f; y = y * 2.03f + 17.1f; a *= 0.5f; }
  return s;
}

__DEVICE__ float3 gr_hsv2rgb(float h, float s, float v) {
  float r = _fabs(gr_fract(h + 0.0f) * 6.0f - 3.0f) - 1.0f;
  float g = _fabs(gr_fract(h + 2.0f / 3.0f) * 6.0f - 3.0f) - 1.0f;
  float b = _fabs(gr_fract(h + 1.0f / 3.0f) * 6.0f - 3.0f) - 1.0f;
  return to_float3(v * gr_mix(1.0f, gr_sat(r), s), v * gr_mix(1.0f, gr_sat(g), s), v * gr_mix(1.0f, gr_sat(b), s));
}
__DEVICE__ float3 gr_rgb2hsv(float3 c) {
  float mx = _fmaxf(c.x, _fmaxf(c.y, c.z)), mn = _fminf(c.x, _fminf(c.y, c.z));
  float d = mx - mn, h = 0.0f;
  if (d > 1e-6f) {
    if (mx == c.x) h = (c.y - c.z) / d;
    else if (mx == c.y) h = 2.0f + (c.z - c.x) / d;
    else h = 4.0f + (c.x - c.y) / d;
    h = gr_fract(h / 6.0f + 1.0f);
  }
  return to_float3(h, mx > 1e-6f ? d / mx : 0.0f, mx);
}
__DEVICE__ float3 gr_hueShift(float3 c, float h) {
  if (h == 0.0f) return c;
  float3 v = gr_rgb2hsv(c);
  return gr_hsv2rgb(gr_fract(v.x + h), v.y, v.z);
}
__DEVICE__ float3 gr_saturate(float3 c, float s) { float l = gr_luma(c); return to_float3(l + (c.x - l) * s, l + (c.y - l) * s, l + (c.z - l) * s); }
__DEVICE__ float3 gr_ramp3(float t, float3 a, float3 b, float3 c) { return t < 0.5f ? gr_mix3(a, b, t * 2.0f) : gr_mix3(b, c, t * 2.0f - 1.0f); }
__DEVICE__ float3 gr_heat(float t) {
  t = gr_sat(t);
  float3 c = gr_mix3(gr_v3(0.0f, 0.0f, 0.15f), gr_v3(0.35f, 0.0f, 0.65f), gr_smooth(0.0f, 0.25f, t));
  c = gr_mix3(c, gr_v3(0.9f, 0.1f, 0.25f), gr_smooth(0.2f, 0.45f, t));
  c = gr_mix3(c, gr_v3(1.0f, 0.55f, 0.0f), gr_smooth(0.45f, 0.7f, t));
  c = gr_mix3(c, gr_v3(1.0f, 1.0f, 0.55f), gr_smooth(0.7f, 0.95f, t));
  return c;
}

// Sample an image with normalized, bottom-up coordinates.
__DEVICE__ float3 gr_tex(__TEXTURE2D__ t, float u, float v) {
  float4 c = _tex2DVecN(t, u, v, 15);
  return to_float3(c.x, c.y, c.z);
}
__DEVICE__ float4 gr_tex4(__TEXTURE2D__ t, float u, float v) { return _tex2DVecN(t, u, v, 15); }

__DEVICE__ float gr_ease(float x) { return x * x * (3.0f - 2.0f * x); }
__DEVICE__ float3 gr_pick(__TEXTURE2D__ A, __TEXTURE2D__ B, float u, float v, float side) { return side < 0.5f ? gr_tex(A, u, v) : gr_tex(B, u, v); }

__KERNEL__ void GRTrans(__CONSTANTREF__ GRTransParams* params, __TEXTURE2D__ A, __TEXTURE2D__ B, __TEXTURE2D_WRITE__ dst) {
  DEFINE_KERNEL_ITERATORS_XY(x, y);
  if (x >= params->width || y >= params->height) return;
  float W = (float)params->width, H = (float)params->height, t = params->iTime;
  float u = ((float)x + 0.5f) / W, v = ((float)y + 0.5f) / H;
  float p = params->p, k = params->intensity;
  float env = _sinf(gr_sat(p) * GR_PI);
  float side = gr_step(0.5f, p);
  float3 tint = to_float3(params->tint[0], params->tint[1], params->tint[2]);
  float dxr = params->dirx, dyr = params->diry;
  int mode = params->mode;
  float3 c;
  if (mode == 0) {
    c = gr_pick(A, B, u, v, side);
    float f = _expf(-_fabs(p - 0.5f) * (6.0f + 10.0f * (1.0f - k)));
    c = gr_add3(gr_scale3(c, 1.0f + f * 4.0f * k), gr_v3(f * k * 1.2f, f * k * 1.2f, f * k * 1.2f));
  } else if (mode == 1) {
    float j = (gr_hash11(_floor(v * 90.0f) + _floor(t * 40.0f)) - 0.5f) * 0.08f * env * k;
    c = gr_pick(A, B, u + j, v, side);
    float nn = gr_hash21(_floor((float)x / 2.0f) + _floor(t * 60.0f) * 3.1f, _floor((float)y / 2.0f) + _floor(t * 60.0f) * 3.1f);
    float bars = 0.5f + 0.5f * _sinf(v * 40.0f + t * 30.0f);
    float m = nn * (0.6f + 0.4f * bars);
    c = gr_mix3(c, gr_v3(m, m, m), gr_sat(_powf(env, 0.6f) * k * 1.1f));
  } else if (mode == 2) {
    float st = _floor(p * (8.0f + k * 14.0f));
    float m = st - 4.0f * _floor(st / 4.0f);
    if (m < 1.0f) c = gr_tex(A, u, v);
    else if (m < 2.0f) c = gr_v3(1.0f, 1.0f, 1.0f);
    else if (m < 3.0f) c = gr_tex(B, u, v);
    else c = gr_v3(0.0f, 0.0f, 0.0f);
    if (p > 0.85f) c = gr_tex(B, u, v);
    if (p < 0.08f) c = gr_tex(A, u, v);
  } else if (mode == 3) {
    float px = (1.0f + env * env * k * 90.0f) * params->scale;
    float gx = (_floor((float)x / px) + 0.5f) * px / W, gy = (_floor((float)y / px) + 0.5f) * px / H;
    c = gr_mix3(gr_tex(A, gx, gy), gr_tex(B, gx, gy), gr_smooth(0.4f, 0.6f, p));
  } else if (mode == 4) {
    float dx = (u - 0.5f) * W / H, dy = v - 0.5f;
    float r = gr_len(dx, dy);
    float rad = gr_ease(p) * 1.4f;
    float ring = 1.0f - gr_smooth(0.0f, 0.12f, _fabs(r - rad));
    float nx = dx / (r + 1e-5f), ny = dy / (r + 1e-5f);
    float ox = nx * ring * 0.06f * k, oy = ny * ring * 0.06f * k;
    // textures cannot be stored in variables on OpenCL, so sample both and pick
    float3 ca = gr_v3(gr_tex(A, u - ox * 1.2f, v - oy * 1.2f).x, gr_tex(A, u - ox, v - oy).y, gr_tex(A, u - ox * 0.8f, v - oy * 0.8f).z);
    float3 cb = gr_v3(gr_tex(B, u - ox * 1.2f, v - oy * 1.2f).x, gr_tex(B, u - ox, v - oy).y, gr_tex(B, u - ox * 0.8f, v - oy * 0.8f).z);
    c = r < rad ? cb : ca;
    c = gr_add3(c, gr_scale3(tint, ring * env * 0.6f));
  } else if (mode == 5) {
    float ox = dxr * env * 0.12f * k, oy = dyr * env * 0.12f * k;
    float pr = gr_smooth(0.0f, 0.7f, p), pg = gr_smooth(0.15f, 0.85f, p), pb = gr_smooth(0.3f, 1.0f, p);
    c.x = gr_mix(gr_tex(A, u + ox, v + oy).x, gr_tex(B, u + ox, v + oy).x, pr);
    c.y = gr_mix(gr_tex(A, u, v).y, gr_tex(B, u, v).y, pg);
    c.z = gr_mix(gr_tex(A, u - ox, v - oy).z, gr_tex(B, u - ox, v - oy).z, pb);
  } else if (mode == 6) {
    float e = gr_ease(p);
    float spd = env * k * 0.18f;
    float3 s = gr_v3(0.0f, 0.0f, 0.0f);
    for (int i = 0; i < 16; i++) {
      float f = ((float)i / 15.0f - 0.5f) * spd;
      float qx = u + dxr * (e + f), qy = v + dyr * (e + f);
      int inA = (qx >= 0.0f && qx <= 1.0f && qy >= 0.0f && qy <= 1.0f) ? 1 : 0;
      s = gr_add3(s, inA ? gr_tex(A, qx, qy) : gr_tex(B, qx - dxr, qy - dyr));
    }
    c = gr_scale3(s, 1.0f / 16.0f);
  } else if (mode == 7) {
    float z = p < 0.5f ? 1.0f + gr_ease(p * 2.0f) * 2.5f * k : 1.0f + (1.0f - gr_ease((p - 0.5f) * 2.0f)) * 2.5f * k;
    float3 s = gr_v3(0.0f, 0.0f, 0.0f);
    float bl = env * 0.25f * k;
    for (int i = 0; i < 14; i++) {
      float f = 1.0f - bl * (float)i / 13.0f;
      s = gr_add3(s, gr_pick(A, B, 0.5f + (u - 0.5f) / (z * f), 0.5f + (v - 0.5f) / (z * f), side));
    }
    c = gr_scale3(s, 1.0f / 14.0f);
  } else if (mode == 8) {
    float rows = 18.0f + 40.0f * k;
    float row = _floor(v * rows);
    float sw = gr_step(gr_hash11(row * 1.7f), p * 1.2f - 0.1f);
    float sh = (gr_hash11(row + _floor(t * 20.0f)) - 0.5f) * env * 0.35f * k;
    float qx = u + sh;
    c = sw > 0.5f ? gr_tex(B, qx, v) : gr_tex(A, qx, v);
    c.x = (sw > 0.5f ? gr_tex(B, qx + 0.01f * env, v) : gr_tex(A, qx + 0.01f * env, v)).x;
    c = gr_add3(c, gr_scale3(tint, gr_step(0.96f, gr_hash21(row, _floor(t * 25.0f))) * env));
  } else if (mode == 9) {
    float dx = u - 0.5f, dy = v - 0.5f, r = gr_len(dx, dy);
    float w = _sinf(r * 60.0f - t * 12.0f) * 0.02f * env * k;
    float ox = dx / (r + 1e-5f) * w, oy = dy / (r + 1e-5f) * w;
    c = gr_mix3(gr_tex(A, u + ox, v + oy), gr_tex(B, u + ox, v + oy), gr_smooth(0.35f, 0.65f, p));
  } else if (mode == 10) {
    float dx = u - 0.5f, dy = v - 0.5f;
    float3 s = gr_v3(0.0f, 0.0f, 0.0f);
    float st = env * 0.5f * k;
    for (int i = 0; i < 18; i++) {
      float f = 1.0f - st * (float)i / 17.0f;
      s = gr_add3(s, gr_pick(A, B, 0.5f + dx * f, 0.5f + dy * f, side));
    }
    c = gr_scale3(s, 1.0f / 18.0f);
    c = gr_add3(c, gr_scale3(tint, _expf(-gr_len(dx, dy) * 6.0f) * env * env * 2.0f));
  } else if (mode == 11) {
    float3 s = gr_v3(0.0f, 0.0f, 0.0f);
    for (int i = 0; i < 5; i++) {
      float fi = (float)i;
      float ox = _sinf(t * 3.0f + fi * 1.7f) * 0.03f * env * k * fi, oy = _cosf(t * 2.3f + fi) * 0.03f * env * k * fi;
      float sp = gr_sat(p * 1.4f - fi * 0.1f);
      s = gr_add3(s, gr_scale3(gr_mix3(gr_tex(A, u + ox, v + oy), gr_tex(B, u + ox, v + oy), gr_smooth(0.3f, 0.7f, sp)), i == 0 ? 1.0f : 0.5f));
    }
    c = gr_scale3(s, 1.0f / 3.0f);
    c = gr_mix3(c, gr_mul3(c, gr_v3(0.7f, 1.0f, 1.15f)), env);
  } else if (mode == 12) {
    float nn = gr_fbm(u * 4.0f + t * 0.2f, v * 4.0f + t * 0.2f);
    float th = p * 1.3f - 0.15f;
    float l = gr_luma(gr_tex(A, u, v)) * 0.5f + nn * 0.5f;
    float burn = 1.0f - gr_smooth(th - 0.08f, th, l);
    float edge = 1.0f - gr_smooth(0.0f, 0.09f, _fabs(l - th));
    c = gr_mix3(gr_tex(A, u, v), gr_tex(B, u, v), burn);
    c = gr_add3(c, gr_scale3(gr_add3(gr_v3(2.0f, 1.1f, 0.2f), gr_scale3(tint, 0.5f)), edge * k));
  } else {
    float tt = _floor(t * 15.0f);
    float m = 1.0f + _floor(gr_hash11(tt) * 3.0f);
    float bx = _floor(u * 8.0f * m), by = _floor(v * 6.0f * m);
    float h = gr_hash21(bx, by);
    float sw = gr_step(h, p);
    float2 oo = gr_hash22(bx + tt, by + tt);
    float on = gr_step(0.7f, gr_hash21(bx + tt * 1.3f, by + tt * 1.3f));
    float ox = (oo.x - 0.5f) * 0.12f * env * k * on, oy = (oo.y - 0.5f) * 0.12f * env * k * on;
    c = sw > 0.5f ? gr_tex(B, u + ox, v + oy) : gr_tex(A, u + ox, v + oy);
    if (gr_hash21(bx + tt * 2.0f, by + tt * 2.0f) > 1.0f - env * 0.25f) c = gr_v3(c.y, c.z, c.x);
  }
  if (params->flash != 0) { float f = _expf(-_fabs(p - 0.5f) * 30.0f) * 0.9f; c = gr_add3(c, gr_v3(f, f, f)); }
  _tex2DVec4Write(dst, x, y, to_float4(c.x, c.y, c.z, 1.0f));
}

]==]
GR_P.GRTrans = [==[
int width; int height; int compOrder; float iTime; float scale; float p; int mode; float intensity; int flash; float dirx; float diry; float tint[3];
]==]
GR_K.GRExtract = [==[
// GLITCH RIG — shared DCTL helpers for the Resolve/Fusion kernels.
// Written for every Fusion GPU backend (CUDA, OpenCL, Metal): no swizzles, no
// function overloading, float literals with an f suffix, and only the builtins
// that Fusion provides everywhere (_floor, _fabs, _sinf, _cosf, _powf, _sqrtf,
// _expf, _atan2f, _fmaxf, _fminf, _fmod). Images in Fusion are bottom-up, like GL.

#define GR_PI 3.14159265f

__DEVICE__ float gr_fract(float x) { return x - _floor(x); }
__DEVICE__ float gr_mod(float x, float y) { return x - y * _floor(x / y); }
__DEVICE__ float gr_mix(float a, float b, float t) { return a + (b - a) * t; }
__DEVICE__ float gr_clamp(float x, float a, float b) { return _fminf(_fmaxf(x, a), b); }
__DEVICE__ float gr_sat(float x) { return gr_clamp(x, 0.0f, 1.0f); }
__DEVICE__ float gr_step(float e, float x) { return x < e ? 0.0f : 1.0f; }
__DEVICE__ float gr_smooth(float a, float b, float x) {
  float t = gr_sat((x - a) / (b - a));
  return t * t * (3.0f - 2.0f * t);
}
__DEVICE__ float gr_len(float x, float y) { return _sqrtf(x * x + y * y); }

__DEVICE__ float3 gr_v3(float x, float y, float z) { return to_float3(x, y, z); }
__DEVICE__ float3 gr_mix3(float3 a, float3 b, float t) { return to_float3(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t, a.z + (b.z - a.z) * t); }
__DEVICE__ float3 gr_scale3(float3 a, float s) { return to_float3(a.x * s, a.y * s, a.z * s); }
__DEVICE__ float3 gr_add3(float3 a, float3 b) { return to_float3(a.x + b.x, a.y + b.y, a.z + b.z); }
__DEVICE__ float3 gr_sub3(float3 a, float3 b) { return to_float3(a.x - b.x, a.y - b.y, a.z - b.z); }
__DEVICE__ float3 gr_mul3(float3 a, float3 b) { return to_float3(a.x * b.x, a.y * b.y, a.z * b.z); }
__DEVICE__ float3 gr_max3(float3 a, float3 b) { return to_float3(_fmaxf(a.x, b.x), _fmaxf(a.y, b.y), _fmaxf(a.z, b.z)); }
__DEVICE__ float3 gr_clamp3(float3 a, float lo, float hi) { return to_float3(gr_clamp(a.x, lo, hi), gr_clamp(a.y, lo, hi), gr_clamp(a.z, lo, hi)); }
__DEVICE__ float3 gr_abs3(float3 a) { return to_float3(_fabs(a.x), _fabs(a.y), _fabs(a.z)); }
__DEVICE__ float gr_dist3(float3 a, float3 b) { float dx = a.x - b.x, dy = a.y - b.y, dz = a.z - b.z; return _sqrtf(dx * dx + dy * dy + dz * dz); }
__DEVICE__ float gr_luma(float3 c) { return c.x * 0.2126f + c.y * 0.7152f + c.z * 0.0722f; }

__DEVICE__ float gr_hash11(float p) {
  p = gr_fract(p * 0.1031f);
  p = p * (p + 33.33f);
  p = p * (p + p);
  return gr_fract(p);
}
__DEVICE__ float gr_hash21(float x, float y) {
  float a = gr_fract(x * 0.1031f), b = gr_fract(y * 0.1031f), c = gr_fract(x * 0.1031f);
  float d = a * (b + 33.33f) + b * (c + 33.33f) + c * (a + 33.33f);
  a += d; b += d; c += d;
  return gr_fract((a + b) * c);
}
__DEVICE__ float2 gr_hash22(float x, float y) {
  float a = gr_fract(x * 0.1031f), b = gr_fract(y * 0.1030f), c = gr_fract(x * 0.0973f);
  float d = a * (b + 33.33f) + b * (c + 33.33f) + c * (a + 33.33f);
  a += d; b += d; c += d;
  return to_float2(gr_fract((a + b) * c), gr_fract((a + c) * b));
}
__DEVICE__ float gr_noise(float x, float y) {
  float ix = _floor(x), iy = _floor(y), fx = x - ix, fy = y - iy;
  float ux = fx * fx * (3.0f - 2.0f * fx), uy = fy * fy * (3.0f - 2.0f * fy);
  float a = gr_hash21(ix, iy), b = gr_hash21(ix + 1.0f, iy);
  float c = gr_hash21(ix, iy + 1.0f), d = gr_hash21(ix + 1.0f, iy + 1.0f);
  return gr_mix(gr_mix(a, b, ux), gr_mix(c, d, ux), uy);
}
__DEVICE__ float gr_fbm(float x, float y) {
  float a = 0.5f, s = 0.0f;
  for (int i = 0; i < 5; i++) { s += a * gr_noise(x, y); x = x * 2.03f + 17.1f; y = y * 2.03f + 17.1f; a *= 0.5f; }
  return s;
}

__DEVICE__ float3 gr_hsv2rgb(float h, float s, float v) {
  float r = _fabs(gr_fract(h + 0.0f) * 6.0f - 3.0f) - 1.0f;
  float g = _fabs(gr_fract(h + 2.0f / 3.0f) * 6.0f - 3.0f) - 1.0f;
  float b = _fabs(gr_fract(h + 1.0f / 3.0f) * 6.0f - 3.0f) - 1.0f;
  return to_float3(v * gr_mix(1.0f, gr_sat(r), s), v * gr_mix(1.0f, gr_sat(g), s), v * gr_mix(1.0f, gr_sat(b), s));
}
__DEVICE__ float3 gr_rgb2hsv(float3 c) {
  float mx = _fmaxf(c.x, _fmaxf(c.y, c.z)), mn = _fminf(c.x, _fminf(c.y, c.z));
  float d = mx - mn, h = 0.0f;
  if (d > 1e-6f) {
    if (mx == c.x) h = (c.y - c.z) / d;
    else if (mx == c.y) h = 2.0f + (c.z - c.x) / d;
    else h = 4.0f + (c.x - c.y) / d;
    h = gr_fract(h / 6.0f + 1.0f);
  }
  return to_float3(h, mx > 1e-6f ? d / mx : 0.0f, mx);
}
__DEVICE__ float3 gr_hueShift(float3 c, float h) {
  if (h == 0.0f) return c;
  float3 v = gr_rgb2hsv(c);
  return gr_hsv2rgb(gr_fract(v.x + h), v.y, v.z);
}
__DEVICE__ float3 gr_saturate(float3 c, float s) { float l = gr_luma(c); return to_float3(l + (c.x - l) * s, l + (c.y - l) * s, l + (c.z - l) * s); }
__DEVICE__ float3 gr_ramp3(float t, float3 a, float3 b, float3 c) { return t < 0.5f ? gr_mix3(a, b, t * 2.0f) : gr_mix3(b, c, t * 2.0f - 1.0f); }
__DEVICE__ float3 gr_heat(float t) {
  t = gr_sat(t);
  float3 c = gr_mix3(gr_v3(0.0f, 0.0f, 0.15f), gr_v3(0.35f, 0.0f, 0.65f), gr_smooth(0.0f, 0.25f, t));
  c = gr_mix3(c, gr_v3(0.9f, 0.1f, 0.25f), gr_smooth(0.2f, 0.45f, t));
  c = gr_mix3(c, gr_v3(1.0f, 0.55f, 0.0f), gr_smooth(0.45f, 0.7f, t));
  c = gr_mix3(c, gr_v3(1.0f, 1.0f, 0.55f), gr_smooth(0.7f, 0.95f, t));
  return c;
}

// Sample an image with normalized, bottom-up coordinates.
__DEVICE__ float3 gr_tex(__TEXTURE2D__ t, float u, float v) {
  float4 c = _tex2DVecN(t, u, v, 15);
  return to_float3(c.x, c.y, c.z);
}
__DEVICE__ float4 gr_tex4(__TEXTURE2D__ t, float u, float v) { return _tex2DVecN(t, u, v, 15); }

__KERNEL__ void GRExtract(__CONSTANTREF__ GRExtractParams* params, __TEXTURE2D__ src, __TEXTURE2D_WRITE__ dst) {
  DEFINE_KERNEL_ITERATORS_XY(x, y);
  if (x >= params->width || y >= params->height) return;
  float W = (float)params->width, H = (float)params->height;
  float u = ((float)x + 0.5f) / W, v = ((float)y + 0.5f) / H;
  float du = 1.5f * params->scale / W, dv = 1.5f * params->scale / H;
  float3 c = gr_add3(gr_add3(gr_tex(src, u - du, v - dv), gr_tex(src, u + du, v - dv)), gr_add3(gr_tex(src, u - du, v + dv), gr_tex(src, u + du, v + dv)));
  c = gr_scale3(c, 0.25f);
  float l = _fmaxf(c.x, _fmaxf(c.y, c.z));
  c = gr_scale3(c, gr_smooth(params->thresh, params->thresh + 0.3f, l));
  _tex2DVec4Write(dst, x, y, to_float4(c.x, c.y, c.z, 1.0f));
}


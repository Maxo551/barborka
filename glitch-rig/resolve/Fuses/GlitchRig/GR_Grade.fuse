    case 5: { int n = 35; int k = ((i % n) + n) % n;
      switch (k) { case 0: return 17; case 1: return 30; case 2: return 22; case 3: return 33; case 4: return 34; case 5: return 35; case 6: return 36; case 7: return 15; case 8: return 39; case 9: return 40; case 10: return 20; case 11: return 23; case 12: return 1; case 13: return 19; case 14: return 7; case 15: return 37; case 16: return 38; case 17: return 45; case 18: return 2; case 19: return 3; case 20: return 4; case 21: return 48; case 22: return 6; case 23: return 9; case 24: return 27; case 25: return 46; case 26: return 5; case 27: return 8; case 28: return 21; case 29: return 25; case 30: return 43; case 31: return 47; case 32: return 0; case 33: return 44; case 34: return 24; } return 0; }
    case 6: { int n = 15; int k = ((i % n) + n) % n;
      switch (k) { case 0: return 111; case 1: return 113; case 2: return 101; case 3: return 110; case 4: return 105; case 5: return 106; case 6: return 109; case 7: return 115; case 8: return 102; case 9: return 112; case 10: return 107; case 11: return 108; case 12: return 103; case 13: return 114; case 14: return 104; } return 0; }
    case 7: { int n = 16; int k = ((i % n) + n) % n;

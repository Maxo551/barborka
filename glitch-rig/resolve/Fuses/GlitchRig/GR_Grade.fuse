// index i of character set s (0 symbols .. 7 ascii), densest last
__DEVICE__ int gr_setGlyph(int s, int i) {
  switch (s) {
    case 0: { int n = 28; int k = ((i % n) + n) % n;
      switch (k) { case 0: return 16; case 1: return 11; case 2: return 17; case 3: return 29; case 4: return 18; case 5: return 30; case 6: return 31; case 7: return 22; case 8: return 33; case 9: return 34; case 10: return 32; case 11: return 35; case 12: return 36; case 13: return 15; case 14: return 14; case 15: return 20; case 16: return 23; case 17: return 39; case 18: return 40; case 19: return 19; case 20: return 37; case 21: return 38; case 22: return 26; case 23: return 27; case 24: return 25; case 25: return 21; case 26: return 24; case 27: return 28; } return 0; }

  sources there, not this file.
]]

FuRegisterClass("GR_Trip", CT_Tool, {
  REGS_Category = "Glitch Rig",
  REGS_OpIconString = "GRt",
  REGS_OpDescription = "Glitch Rig · Trip: warp, melt, patterns and tracers",
  REG_NoObjMatCtrls = true,
